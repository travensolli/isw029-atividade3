{
  "name": "isw029-atividade3",
  "version": "1.0.0",
  "private": true,
  "description": "API Express com TypeScript e PostgreSQL para alunos, cursos e matrículas, refatorada para receber banco, repositórios e serviços por injeção de dependência.",
  "keywords": [
    "typescript",
    "express",
    "postgresql",
    "injecao-de-dependencia",
    "docker"
  ],
  "author": "Gabriel Travensolli",
  "license": "MIT",
  "engines": {
    "node": ">=20.6"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file=../.env dist/main.js",
    "dev": "node --env-file=../.env --import tsx --watch src/main.ts",
    "start:prod": "node --env-file=../.env dist/main.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "express": "^5.3.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}
